DEVICE_ID=car-001

# --- Camera: 0 = webcam/Pi camera qua V4L2, hoặc đường dẫn video để test ---
CAMERA_SOURCE=0

# --- YOLO26n đã fine-tune 2 lớp: adult / child ---
YOLO_WEIGHTS=models/adult_child.pt

# --- MQTT tới phần hardware ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
CMD_SECRET=change-me            # PHẢI trùng với hardware

# --- Đăng nhập app + JWT ---
APP_USERNAME=parent
APP_PASSWORD=change-me
JWT_SECRET=change-me-too

# --- VLM (Ollama) + LLM cho CrewAI ---
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:3b
CREW_LLM_MODEL=ollama/qwen2.5:3b
CREW_LLM_BASE_URL=http://localhost:11434

# --- Thông báo (tuỳ chọn) ---
FCM_CREDENTIALS_PATH=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
